# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# Ne partage jamais le fichier ".env" et ne le mets pas sur GitHub.

PORT=3000

# Adresse publique du site (utile pour le retour après un paiement par carte).
# En local, laisse vide.
BASE_URL=

# --- Citation générée par IA --------------------------------------------
# Clé API Anthropic (https://console.anthropic.com). Sans clé, le client
# peut quand même écrire sa propre citation.
ANTHROPIC_API_KEY=
# Modèle utilisé (rapide et économique par défaut)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Paiement par carte (optionnel) --------------------------------------
# Sans clé, l'option « Carte bancaire » est grisée et seul le paiement à
# la livraison est proposé. Voir le README pour les alternatives au Maroc.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monnaie envoyée à Stripe (par défaut : celle de public/js/config.js)
STRIPE_CURRENCY=

# --- E-mails envoyés aux clients ------------------------------------------
# Le client reçoit un e-mail de confirmation, et toi une alerte « nouvelle
# commande ». Exemple avec Gmail (mot de passe d'application obligatoire) :
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=toi@gmail.com
# Sans ces réglages, les e-mails ne partent pas : ils sont enregistrés dans
# data/outbox/ pour que tu voies à quoi ils ressemblent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Nom affiché chez le client, ex. Coeurete <toi@gmail.com> (vide = SMTP_USER)
MAIL_FROM=
# Adresse qui reçoit les alertes de nouvelle commande (vide = SMTP_USER)
OWNER_EMAIL=

# --- Page d'administration -----------------------------------------------
# Mot de passe pour voir les commandes sur /admin. Choisis une longue phrase.
# Vide = page d'administration désactivée.
ADMIN_TOKEN=
